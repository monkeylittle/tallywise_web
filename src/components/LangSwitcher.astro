---
// Language switcher WITHIN the current region: links to the CURRENT page in each
// language the region offers (Belgium: nl/fr/en, Netherlands: nl/en). Regions
// with a single language (Ireland, UK) and the legacy German pages show none.
// Rendered as a native <details> menu so it needs no JavaScript.
import { LANGUAGES, REGIONS, altsFor, type Lang, type PageKey, type RegionOrAll } from '../i18n/config';
import { getRegionContent } from '../i18n/content';

interface Props {
  lang: Lang;
  page: PageKey;
  region?: RegionOrAll;
}
const { lang, page, region } = Astro.props;
const real = region && region !== 'ALL' ? region : null;
const alts = real ? altsFor(page, real) : [];
const show = alts.length > 1;
const c = getRegionContent(region ?? 'ALL', lang);
const current = LANGUAGES.find((l) => l.code === lang)!;
---
{show && (
  <details class="lang" aria-label={c.nav.langMenuLabel}>
    <summary class="lang__btn" title={c.nav.langMenuLabel}>
      <svg class="lang__globe" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"
           fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="10" />
        <path d="M2 12h20" />
        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
      </svg>
      <span>{current.label}</span>
    </summary>
    <ul class="lang__menu">
      {alts.map((a) => {
        const l = LANGUAGES.find((x) => x.code === a.lang)!;
        const isCurrent = a.lang === lang;
        return (
          <li>
            <a href={a.href} lang={l.htmlLang} hreflang={REGIONS[real!].locale[a.lang] ?? l.htmlLang}
               aria-current={isCurrent ? 'true' : undefined}
               class={isCurrent ? 'is-current' : undefined}>{l.label}</a>
          </li>
        );
      })}
    </ul>
  </details>
)}
