---
// Language switcher: links to the CURRENT page in each language (so switching
// keeps you on the same page). Rendered as a native <details> menu so it needs
// no JavaScript and works on GitHub Pages' static hosting.
import { LANGUAGES, altsFor, type Lang, type PageKey } from '../i18n/config';
import { getContent } from '../i18n/content';

interface Props {
  lang: Lang;
  page: PageKey;
}
const { lang, page } = Astro.props;
const c = getContent(lang);
const current = LANGUAGES.find((l) => l.code === lang)!;
const alts = altsFor(page);
---
<details class="lang" aria-label={c.nav.langMenuLabel}>
  <summary class="lang__btn" title={c.nav.langMenuLabel}>
    <svg class="lang__globe" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"
         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10" />
      <path d="M2 12h20" />
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" />
    </svg>
    <span>{current.label}</span>
  </summary>
  <ul class="lang__menu">
    {LANGUAGES.map((l) => {
      const href = alts.find((a) => a.lang === l.code)!.href;
      const isCurrent = l.code === lang;
      return (
        <li>
          <a href={href} lang={l.htmlLang} hreflang={l.htmlLang}
             aria-current={isCurrent ? 'true' : undefined}
             class={isCurrent ? 'is-current' : undefined}>{l.label}</a>
        </li>
      );
    })}
  </ul>
</details>
