---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppCta from '../../components/AppCta.astro';
import CompareCard from '../../components/CompareCard.astro';
import type { Lang, RegionOrAll } from '../../i18n/config';
import { shotPath } from '../../i18n/config';
import { REGIONS } from '../../i18n/regions';
import { getRegionContent } from '../../i18n/content';

interface Props { lang: Lang; region: RegionOrAll }
const { lang, region } = Astro.props;
const c = getRegionContent(region, lang).howItWorks;
---
<BaseLayout lang={lang} region={region} page="howItWorks" title={c.title} description={c.description}>
  <section class="hero">
    <div class="container">
      <div class="hero__grid">
        <div class="hero__col">
          <h1 set:html={c.hero.h1} />
          <p class="hero__sub" set:html={c.hero.sub} />
        </div>
        <CompareCard lang={lang} region={region} />
      </div>
    </div>
  </section>

  <section class="how">
    <div class="container">
      <ol class="steps">
        {c.steps.map((step, i) => (
          <li>
            <span class="step__num">{i + 1}</span>
            <h3 set:html={step.h} />
            <p set:html={step.p} />
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="shots">
    <div class="container">
      <h2 set:html={c.shots.h2} />
      <div class="shots__grid">
        {['scan', 'list', 'compare', 'deals'].map((name, i) => (
          <figure class="shot">
            <img src={shotPath(region, lang, name)} width="592" height="1280"
                 loading="lazy" alt={c.shots.items[i].alt} />
            <figcaption>{c.shots.items[i].caption}</figcaption>
          </figure>
        ))}
      </div>
      <p class="shots__note">{getRegionContent(region, lang).region.illustrative}</p>
    </div>
  </section>

  <AppCta lang={lang} region={region} heading={c.ctaHeading} />
</BaseLayout>
