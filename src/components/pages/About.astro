---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppCta from '../../components/AppCta.astro';
import CompareCard from '../../components/CompareCard.astro';
import type { Lang, RegionOrAll } from '../../i18n/config';
import { getRegionContent, resolve } from '../../i18n/content';

interface Props { lang: Lang; region: RegionOrAll }
const { lang, region } = Astro.props;
const c = getRegionContent(region, lang).about;
const r = (s: string) => resolve(s, lang, region);
---
<BaseLayout lang={lang} region={region} page="about" title={c.title} description={c.description}>
  <section class="hero">
    <div class="container">
      <div class="hero__grid">
        <div class="hero__col">
          <h1 set:html={c.hero.h1} />
          <p class="hero__sub" set:html={c.hero.sub} />
        </div>
        <CompareCard lang={lang} region={region} />
      </div>
    </div>
  </section>

  <section class="how">
    <div class="container prose">
      <h2 set:html={c.why.h2} />
      {c.why.ps.map((p) => <p set:html={p} />)}

      <h2 set:html={c.how.h2} />
      <ul>{c.how.list.map((li) => <li set:html={r(li)} />)}</ul>

      <h2 set:html={c.who.h2} />
      <p set:html={c.who.p} />

      <h2 set:html={c.contact.h2} />
      <p set:html={r(c.contact.p)} />
    </div>
  </section>

  <AppCta lang={lang} region={region} heading={c.ctaHeading} />
</BaseLayout>
