---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppCta from '../../components/AppCta.astro';
import CompareCard from '../../components/CompareCard.astro';
import type { Lang, RegionOrAll } from '../../i18n/config';
import { getRegionContent, resolve } from '../../i18n/content';
import { REGIONS } from '../../i18n/regions';
import { pathFor } from '../../i18n/config';

interface Props { lang: Lang; region: RegionOrAll }
const { lang, region } = Astro.props;
const all = getRegionContent(region, lang);
const c = all.coupons;
const elsewhere = region !== 'ALL' && !REGIONS[region].coupons;
const r = (s: string) => resolve(s, lang, region);

// Positional icons for the coupon feature cards (snap · scan at till · share).
const couponIcons = [
  '<svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.6 13.4l-7.2 7.2a2 2 0 0 1-2.8 0L2 12V2h10l8.6 8.6a2 2 0 0 1 0 2.8z"/><circle cx="7" cy="7" r="1.4"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="12" rx="1.5"/><path d="M7 9v6M10 9v6M13 9v6M16 9v6"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 2l4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><path d="M7 22l-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>',
];
---
{elsewhere ? (
<BaseLayout lang={lang} region={region} page="coupons" title={all.couponsElsewhere.title} description={all.couponsElsewhere.description} noindex>
  <section class="hero">
    <div class="container hero__inner">
      <h1 set:html={all.couponsElsewhere.h1} />
      <p class="hero__sub" set:html={all.couponsElsewhere.p} />
      <p><a class="btn btn--ghost" href={pathFor('coupons', 'en', 'IE')}>{all.couponsElsewhere.link}</a></p>
    </div>
  </section>
  <AppCta lang={lang} region={region} heading={all.home.get.h2} />
</BaseLayout>
) : (
<BaseLayout lang={lang} region={region} page="coupons" title={c.title} description={c.description}>
  <section class="hero">
    <div class="container">
      <div class="hero__grid">
        <div class="hero__col">
          <h1 set:html={c.hero.h1} />
          <p class="hero__sub" set:html={c.hero.sub} />
        </div>
        <CompareCard lang={lang} region={region} />
      </div>
    </div>
  </section>

  <section class="why">
    <div class="container">
      <h2 set:html={c.how.h2} />
      <div class="why__grid">
        {c.how.cards.map((card, i) => (
          <div class="why__card">
            <div class="card-ic" set:html={couponIcons[i] ?? couponIcons[0]} />
            <h3 set:html={card.h} />
            <p set:html={card.p} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="how">
    <div class="container prose">
      <h2 set:html={c.fair.h2} />
      {c.fair.ps.map((p) => <p set:html={p} />)}
    </div>
  </section>

  <section class="faq">
    <div class="container">
      <h2 set:html={c.faq.h2} />
      <dl class="faq__list">
        {c.faq.items.map((item) => (
          <div>
            <dt set:html={item.q} />
            <dd set:html={r(item.a)} />
          </div>
        ))}
      </dl>
    </div>
  </section>

  <AppCta lang={lang} region={region} heading={c.ctaHeading} />
</BaseLayout>
)}
