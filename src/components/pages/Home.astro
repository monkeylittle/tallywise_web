---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompareCard from '../../components/CompareCard.astro';
import { site } from '../../site';
import type { Lang, RegionOrAll } from '../../i18n/config';
import { shotPath } from '../../i18n/config';
import { REGIONS } from '../../i18n/regions';
import { getRegionContent } from '../../i18n/content';

interface Props { lang: Lang; region: RegionOrAll }
const { lang, region } = Astro.props;
const c = getRegionContent(region, lang).home;

// The region's own store list (the legacy German pages list the Irish one).
const stores = REGIONS[region === 'ALL' ? 'IE' : region].stores;
const hasCoupons = region === 'ALL' || REGIONS[region].coupons;

// Decorative icons for the three "why" cards (positional, so no translation).
const whyIcons = [
  '<svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M7 14l4-4 3 3 5-6"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg>',
];
---
<BaseLayout lang={lang} region={region} page="home" title={c.title}>
  <section class="hero">
    <div class="container">
      <div class="hero__grid">
        <div class="hero__col">
          <span class="eyebrow" set:html={c.hero.note} />
          <h1>{c.hero.h1}</h1>
          <p class="hero__sub" set:html={c.hero.sub} />
          <div class="hero__cta">
            <a class="btn btn--primary" href="#get">{c.hero.ctaGet}</a>
            <a class="btn btn--ghost" href="#how">{c.hero.ctaHow}</a>
          </div>
        </div>

        <CompareCard lang={lang} region={region} />
      </div>
    </div>
  </section>

  <section class="why" id="why">
    <div class="container">
      <h2 set:html={c.why.h2} />
      <p class="why__lead" set:html={c.why.lead} />
      <div class="why__grid why__grid--payoff">
        {c.why.cards.map((card, i) => (
          <div class="why__card">
            <div class="card-ic" set:html={whyIcons[i]} />
            <h3 set:html={card.h} />
            <p set:html={card.p} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="how" id="how">
    <div class="container">
      <h2 set:html={c.how.h2} />
      <ol class="steps">
        {c.how.steps.map((step, i) => (
          <li>
            <span class="step__num">{i + 1}</span>
            <h3 set:html={step.h} />
            <p set:html={step.p} />
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="lists" id="lists">
    <div class="container">
      <h2 set:html={c.listsSec.h2} />
      <p class="why__lead" set:html={c.listsSec.lead} />
      <div class="why__grid">
        {c.listsSec.cards.map((card) => (
          <div class="why__card">
            <h3 set:html={card.h} />
            <p set:html={card.p} />
          </div>
        ))}
      </div>
    </div>
  </section>

  {hasCoupons && <section class="coupons" id="coupons">
    <div class="container">
      <h2 set:html={c.couponsSec.h2} />
      <p class="why__lead" set:html={c.couponsSec.lead} />
      <div class="why__grid">
        {c.couponsSec.cards.map((card) => (
          <div class="why__card">
            <h3 set:html={card.h} />
            <p set:html={card.p} />
          </div>
        ))}
      </div>
    </div>
  </section>}

  <section class="shots" id="shots">
    <div class="container">
      <h2 set:html={c.shots.h2} />
      <div class="shots__grid">
        {['scan', 'list', 'compare', 'deals'].map((name, i) => (
          <figure class="shot">
            <img src={shotPath(region, name)} width="592" height="1280"
                 loading="lazy" alt={c.shots.items[i].alt} />
            <figcaption>{c.shots.items[i].caption}</figcaption>
          </figure>
        ))}
      </div>
      {region !== 'ALL' && REGIONS[region].illustrativeScreens && <p class="shots__note">{getRegionContent(region, lang).region.illustrative}</p>}
    </div>
  </section>

  <section class="stores" id="stores">
    <div class="container">
      <h2 set:html={c.stores.h2} />
      <p class="why__lead" set:html={c.stores.lead} />
      <ul class="stores__grid">
        {stores.map((s) => <li>{s}</li>)}
      </ul>
      <p class="stores__note" set:html={c.stores.loyalty} />
      <p class="stores__note" set:html={c.stores.note1} />
      {region === 'ALL' && <p class="stores__note" set:html={c.stores.note3} />}
    </div>
  </section>
  <section class="faq" id="faq">
    <div class="container">
      <h2 set:html={c.faq.h2} />
      <dl class="faq__list">
        {c.faq.items.map((item) => (
          <div>
            <dt set:html={item.q} />
            <dd set:html={item.a} />
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="membership" id="membership">
    <div class="container">
      <h2 set:html={c.membership.h2} />
      <p set:html={c.membership.intro} />

      <h3 set:html={c.membership.bronzeH} />
      <ul>{c.membership.bronze.map((li) => <li set:html={li} />)}</ul>

      <h3 set:html={c.membership.silverH} />
      <ul>{c.membership.silver.map((li) => <li set:html={li} />)}</ul>

      <h3 set:html={c.membership.keepH} />
      <p set:html={c.membership.keep} />
    </div>
  </section>

  <section class="beta" id="get">
    <div class="container">
      <div class="beta__card beta__card--navy">
        <h2 set:html={c.get.h2} />
        <p class="beta__sub" set:html={c.get.sub} />
        <div class="hero__cta">
          <a class="btn btn--primary" href={site.appStoreUrl} set:html={getRegionContent(region, lang).buttons.iphone} />
          <a class="btn btn--ghost" href={site.playStoreUrl} set:html={getRegionContent(region, lang).buttons.android} />
        </div>
        <p class="beta__hint">
          {c.get.hintLabel} <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
