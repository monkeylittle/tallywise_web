---
import { site } from '../site';
import { pathFor, type Lang, type PageKey } from '../i18n/config';
import { getContent } from '../i18n/content';
import LangSwitcher from './LangSwitcher.astro';

interface Props {
  lang: Lang;
  page: PageKey;
}
const { lang, page } = Astro.props;
const c = getContent(lang);

// Nav targets, localized. "Get the app" points at the #get band on the home page.
const links = [
  { href: pathFor('howItWorks', lang), label: c.nav.howItWorks },
  { href: pathFor('coupons', lang), label: c.nav.coupons },
  { href: pathFor('savings', lang), label: c.nav.savings },
  { href: pathFor('about', lang), label: c.nav.about },
  { href: `${pathFor('home', lang)}#get`, label: c.nav.getApp },
];
---
<header class="nav">
  <div class="container nav__inner">
    <a class="nav__brand" href={pathFor('home', lang)}>
      <img class="logo" src="/app-icon.png" alt="" width="38" height="38" />
      <span>{site.name}</span>
    </a>
    <nav class="nav__links" aria-label="Primary">
      {links.map((item) => <a href={item.href}>{item.label}</a>)}
      <LangSwitcher lang={lang} page={page} />
    </nav>
  </div>
</header>
