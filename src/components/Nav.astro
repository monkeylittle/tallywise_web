---
import { site } from '../site';
import { LANGUAGES, REGION_CODES, REGIONS, altsFor, pathFor, regionHref, type Lang, type PageKey, type RegionOrAll } from '../i18n/config';
import { getRegionContent } from '../i18n/content';
import LangSwitcher from './LangSwitcher.astro';
import RegionSwitcher from './RegionSwitcher.astro';

interface Props {
  lang: Lang;
  page: PageKey;
  region?: RegionOrAll;
  /** Region chooser page: brand + region menu only. */
  chooser?: boolean;
}
const { lang, page, region, chooser = false } = Astro.props;
const c = getRegionContent(region ?? 'ALL', lang);
const real = region && region !== 'ALL' ? region : null;
const showCoupons = !real || REGIONS[real].coupons;
const showBlog = !!real && REGIONS[real].blog;

// Nav targets, localized and region-aware. "Get the app" points at the #get
// band on the region's home page. Coupons only exist in Ireland.
const links = chooser
  ? []
  : [
      { href: pathFor('howItWorks', lang, region), label: c.nav.howItWorks },
      ...(showCoupons ? [{ href: pathFor('coupons', lang, region), label: c.nav.coupons }] : []),
      { href: pathFor('savings', lang, region), label: c.nav.savings },
      ...(showBlog ? [{ href: '/blog/', label: 'Blog' }] : []),
      { href: pathFor('about', lang, region), label: c.nav.about },
      { href: `${pathFor('home', lang, region)}#get`, label: c.nav.getApp },
    ];
const alts = real && !chooser ? altsFor(page, real) : [];
const getHref = `${pathFor('home', lang, region)}#get`;
const brandHref = chooser ? '/?choose=1' : pathFor('home', lang, region);
---
<header class="nav">
  <div class="container nav__inner">
    <a class="nav__brand" href={brandHref}>
      <img class="logo" src="/app-icon.png" alt="" width="38" height="38" />
      <span>{site.name}</span>
    </a>
    <nav class="nav__links" aria-label="Primary">
      {links.map((item) => <a href={item.href}>{item.label}</a>)}
      <RegionSwitcher lang={lang} page={page} region={region} />
      <LangSwitcher lang={lang} page={page} region={region} />
    </nav>
    {/* Phones (<=860px): brand + Get-the-app + a native <details> menu (no JS).
        The desktop .nav__links above is hidden at that width. */}
    <div class="nav__mobile">
      {!chooser && <a class="btn btn--primary btn--sm nav__get" href={getHref}>{c.nav.getApp}</a>}
      <details class="menu">
        <summary class="menu__btn" aria-label={c.region.menuLabel}>
          <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </summary>
        <div class="menu__panel">
          {links.map((item) => <a href={item.href}>{item.label}</a>)}
          <p class="menu__h">{c.region.label}</p>
          {REGION_CODES.map((r) => (
            <a href={regionHref(page, lang, r)} data-tw-region={r} class={r === real ? 'is-current' : undefined}>{REGIONS[r].names[lang]}</a>
          ))}
          {alts.length > 1 && <p class="menu__h">{c.nav.langMenuLabel}</p>}
          {alts.length > 1 && alts.map((a) => (
            <a href={a.href} class={a.lang === lang ? 'is-current' : undefined}>{LANGUAGES.find((l) => l.code === a.lang)!.label}</a>
          ))}
        </div>
      </details>
    </div>
  </div>
</header>
