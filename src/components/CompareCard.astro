---
// Reusable basket-comparison card (the product value, visualised). The example
// basket is region-specific (that region's real supermarkets, its currency) and
// labelled as an example. Decorative — aria-hidden; the value is in the copy.
import { REGIONS, money } from '../i18n/regions';
import type { Lang, RegionOrAll } from '../i18n/config';
import { getRegionContent } from '../i18n/content';

interface Props { lang: Lang; region?: RegionOrAll }
const { lang, region } = Astro.props;
const r = region ?? 'ALL';
const compare = getRegionContent(r, lang).home.hero.compare;
// The legacy German pages (no region) keep the Irish example basket.
const shops = REGIONS[r === 'ALL' ? 'IE' : r].compare;
const best = Math.min(...shops.map((s) => s.price));
const rows = [...shops].sort((a, b) => a.price - b.price);
---
<div class="compare" aria-hidden="true">
  <div class="compare__head">
    <strong>{compare.basket}</strong>
    <span>{compare.example} · {compare.caption}</span>
  </div>
  {rows.map((s) => (
    <div class={`compare__row${s.price === best ? ' is-best' : ''}`}>
      <span class="compare__shop">
        <span class="compare__chip" style={`background:${s.color};${s.ink ? `color:${s.ink}` : ''}`}>{s.code}</span>
        {s.name}
        {s.price === best && <span class="compare__tag">{compare.cheapest}</span>}
      </span>
      <span class="compare__price">{money(s.price, r, lang)}</span>
    </div>
  ))}
  <div class="compare__saved">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#7CE0AE" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg>
    <span set:html={compare.save} />
  </div>
</div>
