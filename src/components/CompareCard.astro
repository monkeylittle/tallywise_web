---
// Reusable basket-comparison card (the product value, visualised). Reads the
// home page's market-appropriate compare data so it stays in one place and
// localised per language. Decorative — aria-hidden; the value is in the copy.
import type { Lang } from '../i18n/config';
import { getContent } from '../i18n/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const compare = getContent(lang).home.hero.compare;
---
<div class="compare" aria-hidden="true">
  <div class="compare__head">
    <strong>{compare.basket}</strong>
    <span>{compare.caption}</span>
  </div>
  {compare.shops.map((s) => (
    <div class={`compare__row${s.best ? ' is-best' : ''}`}>
      <span class="compare__shop">
        <span class="compare__chip" style={`background:${s.color}`}>{s.code}</span>
        {s.name}
        {s.best && <span class="compare__tag">{compare.cheapest}</span>}
      </span>
      <span class="compare__price">{s.price}</span>
    </div>
  ))}
  <div class="compare__saved">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#7CE0AE" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg>
    <span set:html={compare.save} />
  </div>
</div>
