---
import { site } from '../site';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import {
  REGIONS, REGION_CODES, allVariants, htmlLang, regionHref, shotPath,
  type Lang, type PageKey, type RegionOrAll,
} from '../i18n/config';
import { getRegionContent } from '../i18n/content';
import '../styles/global.css';

interface Props {
  lang: Lang;
  /** IE/UK/BE/NL, 'ALL' for the legacy German pages, undefined for the region chooser. */
  region?: RegionOrAll;
  page: PageKey;
  title: string;
  description?: string;
  /** Social-card image path (defaults to the region's scan screen). */
  image?: string;
  /** Keep this page out of search results (e.g. the coupons explainer outside Ireland). */
  noindex?: boolean;
  /** The page is the region chooser at '/'. */
  chooser?: boolean;
}

const { lang, region, page, title, description, image, noindex = false, chooser = false } = Astro.props;
const c = getRegionContent(region ?? 'ALL', lang);
// Default description: the region's own hero sentence (localized, region-specific stores/market,
// tags stripped) rather than the site-wide English line that names every country and coupons.
const heroSub = c.home.hero.sub.replace(/<[^>]+>/g, '').replace(/&rsquo;/g, '’').replace(/\s+/g, ' ').trim();
const desc = description ?? (region && region !== 'ALL' ? heroSub : site.description);
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image ?? shotPath(region, lang, 'scan'), site.url).href;
const real = region && region !== 'ALL' ? region : null;

// hreflang cluster: every region × language variant of this page (en-IE, en-GB,
// nl-BE, fr-BE, en-BE, nl-NL, en-NL) + x-default → the region chooser at '/'.
// Pages outside the cluster (legacy German, coupons explainer) list only themselves.
const inCluster = real && !(page === 'coupons' && !REGIONS[real].coupons);
const alternates = inCluster
  ? allVariants(page).map((v) => ({ hreflang: v.hreflang, href: new URL(v.href, site.url).href }))
  : [];
const xDefault = new URL('/', site.url).href;

const locale = real ? (REGIONS[real].locale[lang] ?? lang) : htmlLang(lang);
const ogLocale = locale.replace('-', '_');
const currency = real ? REGIONS[real].currency.code : 'EUR';
const areaServed = real ? REGIONS[real].names.en : undefined;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site.url}/#organization`,
      name: site.name,
      url: site.url,
      logo: new URL('/app-icon.png', site.url).href,
      ...(site.social.length ? { sameAs: site.social } : {}),
    },
    {
      '@type': 'MobileApplication',
      name: site.name,
      operatingSystem: 'iOS, Android',
      applicationCategory: 'ShoppingApplication',
      description: desc,
      url: canonical,
      inLanguage: locale,
      ...(areaServed ? { countriesSupported: areaServed } : {}),
      installUrl: [site.appStoreUrl, site.playStoreUrl],
      offers: { '@type': 'Offer', price: '0', priceCurrency: currency },
    },
  ],
};

// Data for the (tiny) region script: where each region's version of THIS page is.
const regionData = Object.fromEntries(
  REGION_CODES.map((r) => [
    r,
    { name: REGIONS[r].names[lang], href: regionHref(page, lang, r), tz: REGIONS[r].timezones },
  ]),
);
---
<!doctype html>
<html lang={htmlLang(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <meta name="theme-color" content="#1B2140" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fredoka:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script is:inline type="application/json" id="tw-regions" set:html={JSON.stringify(regionData)} />
  </head>
  <body data-region={real ?? ''} data-chooser={chooser ? '1' : '0'}>
    <a class="skip-link" href="#main">{c.meta.skip}</a>
    <Nav lang={lang} page={page} region={region} chooser={chooser} />
    <div
      id="tw-region-suggest"
      class="region-suggest"
      hidden
      data-suggest={c.region.suggest}
      data-switch={c.region.switchBtn}
      data-stay={c.region.stay}
    ></div>
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} region={region} page={page} />

    <script is:inline>
      // Region memory + first-visit SUGGESTION. Never auto-redirects a visitor
      // who has not chosen yet (crawlers and first-time readers see the page
      // they asked for); only a stored choice redirects, and only from '/'.
      (function () {
        var REG = ['IE', 'UK', 'BE', 'NL'];
        var data; try { data = JSON.parse(document.getElementById('tw-regions').textContent); } catch (e) { return; }
        var body = document.body;
        var cur = body.getAttribute('data-region') || '';
        var chooser = body.getAttribute('data-chooser') === '1';
        var stored = null;
        try { stored = localStorage.getItem('tw_region'); } catch (e) {}
        if (REG.indexOf(stored) < 0) stored = null;

        // An explicit pick in the region menu is remembered immediately.
        document.addEventListener('click', function (e) {
          var a = e.target && e.target.closest ? e.target.closest('a[data-tw-region]') : null;
          if (a) { try { localStorage.setItem('tw_region', a.getAttribute('data-tw-region')); } catch (e2) {} }
        });

        if (chooser && stored && location.search.indexOf('choose') < 0) {
          location.replace(data[stored].href);
          return;
        }

        function guess() {
          try {
            var tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
            for (var i = 0; i < REG.length; i++) {
              if ((data[REG[i]].tz || []).indexOf(tz) >= 0) return REG[i];
            }
          } catch (e) {}
          var langs = navigator.languages || [navigator.language || ''];
          for (var j = 0; j < langs.length; j++) {
            var m = /-([A-Za-z]{2})/.exec(langs[j] || '');
            if (m) { var r = m[1].toUpperCase(); if (r === 'GB') r = 'UK'; if (REG.indexOf(r) >= 0) return r; }
          }
          return null;
        }

        var banner = document.getElementById('tw-region-suggest');
        var g = stored ? null : guess();
        if (banner && g && g !== cur && !chooser) {
          var name = data[g].name;
          var txt = (banner.getAttribute('data-suggest') || '').replace(/%COUNTRY%/g, name);
          banner.innerHTML = '';
          var span = document.createElement('span'); span.textContent = txt;
          var go = document.createElement('a'); go.className = 'btn btn--primary btn--sm';
          go.href = data[g].href; go.textContent = banner.getAttribute('data-switch') || 'Switch';
          go.setAttribute('data-tw-region', g);
          var stay = document.createElement('button'); stay.type = 'button'; stay.className = 'region-suggest__stay';
          stay.textContent = banner.getAttribute('data-stay') || 'Stay here';
          stay.addEventListener('click', function () {
            banner.hidden = true;
            if (cur) { try { localStorage.setItem('tw_region', cur); } catch (e) {} }
          });
          banner.appendChild(span); banner.appendChild(go); banner.appendChild(stay);
          banner.hidden = false;
        }
        // Remember the region of the page being read (an explicit visit is a
        // choice) unless a suggestion is on screen: then its buttons decide.
        if (cur && (!banner || banner.hidden)) { try { localStorage.setItem('tw_region', cur); } catch (e) {} }
      })();
    </script>
  </body>
</html>
